ASPNETCORE_ENVIRONMENT=Production
DATABASE_URL=Host=<supabase-host>;Port=5432;Database=postgres;Username=<supabase-user>;Password=<supabase-password>;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=<random-secret-at-least-32-characters>
Jwt__Issuer=SEAL.API
Jwt__Audience=SEAL.API.Users
Jwt__ExpireDays=7
Auth__CookieSameSite=None
AdminBootstrap__Enabled=false
Cors__AllowedOrigins__0=https://your-vercel-app.vercel.app
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromEmail=
Email__Smtp__FromName=SEAL Hackathon
